# Get a key at https://console.anthropic.com/  (leave empty to run in offline demo mode)
ANTHROPIC_API_KEY=

# Model used for parsing, quizzes and reviews. Cheaper options: claude-sonnet-5-5, claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# Max AI requests (syllabus parse / quiz / review) per user per day. 0 = unlimited.
DAILY_AI_LIMIT=15

# Force demo mode even if a key is set (true/false)
AI_MOCK=false

# Server-side refusal fallback (Claude API only). Set false if your account rejects it.
AI_FALLBACKS=true

# Database. Default: SQLite file at backend/studyflow.db
# Production: a Postgres URL, e.g. postgresql://user:pass@host:5432/studyflow
# DATABASE_URL=

# Signs login sessions. Leave empty locally (auto-generated); set a long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# true in production (HTTPS only cookies)
COOKIE_SECURE=false
