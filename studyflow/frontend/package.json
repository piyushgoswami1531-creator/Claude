{
  "name": "studyflow-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "build:artifact": "tsc -b && vite build --mode artifact && node scripts/to-artifact.mjs",
    "build:netlify": "tsc -b && vite build --mode standalone && node scripts/netlify-extras.mjs",
    "build:single": "tsc -b && vite build --mode single && node -e \"require('fs').renameSync('dist-single/single.html','dist-single/studyflow.html')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@tanstack/react-query": "^5.80.0",
    "framer-motion": "^12.20.0",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "~4.1.18",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "~4.1.18",
    "typescript": "~5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
