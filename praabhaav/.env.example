# Copy to .env (never commit .env) and fill in.
ADMIN_USER=admin
ADMIN_PASSWORD=use-a-long-random-password
# Signs login sessions. Long random string; changing it logs everyone out.
SECRET_KEY=another-long-random-string
# Database: a Postgres URL (e.g. free Neon) wins; otherwise a local SQLite file.
DATABASE_URL=
PRAABHAAV_DB=praabhaav.db
# Free hosting: refuse to start without DATABASE_URL (Render's disk is temporary).
REQUIRE_DATABASE_URL=0
# Scheduled jobs: 1 = run inside the app; 0 = an outside cron calls /cron/run?key=CRON_SECRET
ENABLE_SCHEDULER=1
CRON_SECRET=
# Public URL of the deployed app, used in alert and digest links.
PUBLIC_BASE_URL=https://your-app.example.com

# Phase 2: query agent. Without this the agent uses keyword rules.
ANTHROPIC_API_KEY=
# Phase 2: alerts. Create a bot with @BotFather, message it once, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 3: automatic reel checks (apify.com → Settings → API & Integrations).
APIFY_TOKEN=
