# Copy this file to .env.local and fill in the values.
# Without the Supabase values the site runs on the built-in dummy catalogue.

# Public site address (used in WhatsApp product links and SEO). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase → Project Settings → API → service_role (secret!)
# Server-only: used by the seed script, the admin login check and click tracking. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The owner's login email is NOT set here: add it in Supabase → SQL Editor:
#   insert into admins (email) values ('owner@example.com');

# AI auto-fill for new products (used from step e).
ANTHROPIC_API_KEY=
